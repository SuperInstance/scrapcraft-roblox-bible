The inflate size is correct (65-byte stride × 16 rows = 1040; my "expect" label and channel indexing in that one-liner were wrong — stride is 65, not 17). Re-checking alpha with proper alignment:
[0m$ [0mnode -e "
const fs=require('fs'),zlib=require('zlib');
for (const f of fs.readdirSync('assets/textures').filter(x=>x.endsWith('.png'))) {
  const b=fs.readFileSync('assets/textures/'+f);
  let off=8,idat=[];
  while(off<b.length){const len=b.readUInt32BE(off),type=b.toString('ascii',off+4,off+8);
    if(type==='IDAT')idat.push(b.subarray(off+8,off+8+len));off+=12+len;}
  const raw=Buffer.concat(idat.map(d=>zlib.inflateSync(d)));
  let amin=255,amax=0,colors=new Set();
  for(let y=0;y<16;y++)for(let x=0;x<16;x++){const i=y*65+1+x*4;
    amin=Math.min(amin,raw[i+3]);amax=Math.max(amax,raw[i+3]);
    colors.add(raw[i]+','+raw[i+1]+','+raw[i+2]);}
  console.log(f.padEnd(22), raw.length===1040?'ok ':'BAD', 'alpha',amin+'-'+amax, 'distinct colors',colors.size);
}"
