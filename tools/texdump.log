Quick structural decode check on a sample PNG to confirm the IDAT payload is valid:
[0m$ [0mnode -e "
const fs=require('fs'),zlib=require('zlib');
for (const f of ['04_RUST_METAL.png','20_SCRAP_CANNON.png']) {
  const b=fs.readFileSync('assets/textures/'+f);
  let off=8,idat=[];
  while(off<b.length){const len=b.readUInt32BE(off),type=b.toString('ascii',off+4,off+8);
    if(type==='IDAT')idat.push(b.subarray(off+8,off+8+len));off+=12+len;}
  const raw=Buffer.concat(idat.map(d=>zlib.inflateSync(d)));
  const px=raw.filter((_,i)=>i%17!==0);
  console.log(f,'inflated',raw.length,'bytes (expect',17*16+') alpha min/max:',Math.min(...px.filter((_,i)=>(i%4)===3)),Math.max(...px.filter((_,i)=>(i%4)===3)));
}"
