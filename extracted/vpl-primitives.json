        "pin": "TX=17, RX=16",
        "setup": {
          "arduino": "tts.begin(Serial2);",
          "micropython": "tts = DFPlayer(uart)"
        }
      },
      "firmware": {}
    },
    "servo_angle": {
      "id": "servo_angle",
      "category": "act",
