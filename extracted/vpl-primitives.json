    "speak": {
      "id": "speak",
      "category": "act",
      "label": "speak",
      "blurb": "robot says a short word or phrase (TTS module on ESP32; chat bubble in-game)",
      "requiresBrain": "spark",
      "params": {
        "phrase": {
          "type": "enum",
          "values": [
            "hello",
            "done",
            "warning",
            "help",
            "go"
